[Unit]
Description=Megingjord Stream Deck controller
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/megingjord
Restart=on-failure
# Secrets are read from the environment; set them here or in an
# EnvironmentFile. Do not set a variable to an empty value: the
# config loader treats an unset variable as a clear error.
# Environment=HA_TOKEN=
# EnvironmentFile=%h/.config/megingjord/env

[Install]
WantedBy=default.target
